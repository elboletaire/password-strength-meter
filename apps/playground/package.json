    "@passcore/vue": "workspace:*",
    "@passcore/svelte": "workspace:*",
    "i18next": "catalog:",
    "jquery": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/jquery": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vike": "catalog:",
    "vite": "catalog:"
  }
