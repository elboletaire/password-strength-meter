{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@passcore/core": ["./packages/core/src/index.ts"],
      "@passcore/jquery": ["./packages/jquery/src/index.ts"],
      "@passcore/vanilla": ["./packages/vanilla/src/index.ts"],
      "@passcore/react": ["./packages/react/src/index.ts"],
      "@passcore/vue": ["./packages/vue/src/index.ts"],
      "@passcore/svelte": ["./packages/svelte/src/lib/index.ts"]
    }
  }
}
