{
  "name": "@passcore/react",
  "version": "1.0.0",
  "description": "Password strength meter for React: a hook and a component",
  "keywords": [
    "password",
    "strength",
    "meter",
    "form",
    "react",
    "hook",
    "component"
  ],
  "homepage": "https://github.com/elboletaire/password-strength-meter#readme",
  "bugs": {
    "url": "https://github.com/elboletaire/password-strength-meter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elboletaire/password-strength-meter.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Òscar Casajuana <elboletaire@gmail.com> (https://github.com/elboletaire)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./locales/*.json": "./dist/locales/*.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "check:package": "publint --strict && attw --pack --profile node16 --exclude-entrypoints styles.css locales/en.json locales/es.json locales/ca.json"
  },
  "dependencies": {
    "@passcore/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
