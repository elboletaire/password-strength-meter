{
  "name": "@passcore/jquery",
  "version": "0.2.0",
  "description": "A password strength meter plugin for jQuery",
  "keywords": [
    "jquery-plugin",
    "ecosystem:jquery",
    "jquery",
    "password",
    "strength",
    "meter",
    "form"
  ],
  "homepage": "https://github.com/elboletaire/password-strength-meter#readme",
  "bugs": {
    "url": "https://github.com/elboletaire/password-strength-meter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elboletaire/password-strength-meter.git",
    "directory": "packages/jquery"
  },
  "license": "GPL-3.0",
  "author": "Òscar Casajuana <elboletaire@gmail.com> (https://github.com/elboletaire)",
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./password.min.js": "./dist/password.min.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/password.min.js",
  "jsdelivr": "./dist/password.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "check:package": "publint --strict && attw --pack --profile node16 --exclude-entrypoints password.min.js styles.css"
  },
  "dependencies": {
    "@passcore/core": "workspace:^"
  },
  "peerDependencies": {
    "@types/jquery": "*",
    "jquery": ">=1.11.0"
  },
  "peerDependenciesMeta": {
    "@types/jquery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/jquery": "catalog:",
    "@types/jsdom": "catalog:",
    "jquery": "catalog:",
    "jquery4": "npm:jquery@^4.0.0",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
