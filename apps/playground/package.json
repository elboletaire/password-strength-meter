{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "typecheck": "tsc && svelte-check --tsconfig ./tsconfig.json",
    "check": "node --experimental-strip-types scripts/check-site.ts"
  },
  "dependencies": {
    "@passcore/core": "workspace:*",
    "@passcore/jquery": "workspace:*",
    "@passcore/vanilla": "workspace:*",
